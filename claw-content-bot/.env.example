# Copia a `.env` local (no se sube a Git; ver `.gitignore`) o pega las mismas claves en Railway.
# En local, `npm start` carga `.env` automáticamente (dotenv). En Railway las variables vienen del panel.
# Health: GET /health (texto "OK") | Readiness: GET /ready (JSON: ok, slug, paymentConfigured)

# Obligatorio en producción
TELEGRAM_BOT_TOKEN=

# Puerto (Railway suele inyectar PORT)
# PORT=3000

# Webhook: URL completa o dominio público
# WEBHOOK_URL=https://tu-servicio.up.railway.app/<TELEGRAM_BOT_TOKEN>
# RAILWAY_PUBLIC_DOMAIN=tu-servicio.up.railway.app

# Contacto (visible en mensajes del bot)
TALLER_WHATSAPP=903176598

# Datos de pago — NO pongas valores reales en este archivo si vas a commitear.
# Opción A: bloque Markdown completo (útil en Railway)
# PAYMENT_INFO_MARKDOWN=🏦 *Datos de pago:*\nBanco: ...\nCuenta: ...\nCCI: ...\nTitular: ...

# Opción B — líneas sueltas (las cuatro deben estar definidas en Railway o en `.env` local)
# PAYMENT_BANCO=
# PAYMENT_CUENTA=
# PAYMENT_CCI=
# PAYMENT_TITULAR=
