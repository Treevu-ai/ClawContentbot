{
  "name": "claw-content-bot",
  "version": "1.0.0",
  "description": "Telegram bot for content generation",
  "main": "bot.js",
  "scripts": {
    "start": "node bot.js",
    "test": "node --test",
    "verify:assets": "node scripts/verify-landing-sync.js",
    "verify:slides": "node scripts/verify-slides-indice.js",
    "verify": "node scripts/verify-landing-sync.js && node scripts/verify-slides-indice.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "node-telegram-bot-api": "^0.64.0",
    "express": "^4.21.2"
  },
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "form-data": "2.5.5",
    "qs": "6.15.1",
    "tough-cookie": "4.1.3"
  }
}
